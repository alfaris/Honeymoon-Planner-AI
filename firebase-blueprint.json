{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "credits": { "type": "integer", "description": "Remaining generation credits" },
        "isAdmin": { "type": "boolean", "description": "Whether the user is an administrator" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "PaymentRequest": {
      "title": "PaymentRequest",
      "description": "A manual payment verification request for credits",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "amount": { "type": "integer" },
        "price": { "type": "string" },
        "reference": { "type": "string" },
        "proofUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "declined"] },
        "adminComment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "amount", "status"]
    },
    "AppConfig": {
      "title": "AppConfig",
      "description": "Global application settings",
      "type": "object",
      "properties": {
        "instapayHandle": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "SavedTrip": {
      "title": "SavedTrip",
      "description": "A saved honeymoon plan",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "preferences": { "type": "object" },
        "recommendations": { "type": "array" },
        "itinerary": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents"
    },
    "/users/{userId}/saved_trips/{tripId}": {
      "schema": "SavedTrip",
      "description": "User saved itineraries"
    },
    "/payment_requests/{requestId}": {
      "schema": "PaymentRequest",
      "description": "Manual payment verification requests"
    },
    "/config/{configId}": {
      "schema": "AppConfig",
      "description": "Global settings"
    }
  }
}
