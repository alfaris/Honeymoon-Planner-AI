rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
             (!('credits' in data) || (data.credits is int && data.credits >= 0));
    }

    function isValidSavedTrip(data) {
      return data.keys().hasAll(['userId', 'title']) &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() <= 200;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "ahmedfaris.me@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true)
      );
    }

    function isValidPaymentRequest(data) {
      return data.keys().hasAll(['userId', 'amount', 'status']) &&
             data.userId == request.auth.uid &&
             data.amount is int && data.amount > 0 &&
             data.status in ['pending', 'approved', 'declined'] &&
             (!('proofUrl' in data) || (data.proofUrl is string && data.proofUrl.size() <= 2048)) &&
             (!('reference' in data) || (data.reference is string && data.reference.size() <= 512));
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming()) &&
                    incoming().createdAt == request.time &&
                    incoming().updatedAt == request.time;
      allow update: if (isOwner(userId) && isValidUser(incoming()) && 
                    incoming().updatedAt == request.time &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt'])) ||
                    (isAdmin() && incoming().diff(existing()).affectedKeys().hasAny(['credits', 'isAdmin', 'updatedAt']));
    }

    match /payment_requests/{requestId} {
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow get: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidPaymentRequest(incoming()) &&
                    incoming().createdAt == request.time &&
                    incoming().updatedAt == request.time;
      allow update: if isAdmin() && 
                    incoming().updatedAt == request.time &&
                    incoming().diff(existing()).affectedKeys().hasAny(['status', 'adminComment', 'updatedAt']);
    }

    match /config/{configId} {
      allow get: if true; // Publicly readable
      allow write: if isAdmin();
    }

    match /users/{userId}/saved_trips/{tripId} {
      allow list: if isOwner(userId);
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidSavedTrip(incoming()) && isValidId(tripId) &&
                    incoming().createdAt == request.time &&
                    incoming().updatedAt == request.time;
      allow update: if isOwner(userId) && isValidSavedTrip(incoming()) &&
                    incoming().updatedAt == request.time &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['title', 'itinerary', 'recommendations', 'updatedAt']);
      allow delete: if isOwner(userId);
    }
  }
}
